# ProblemForge frontend — copy to .env.local for local development.
# On Vercel set these in Project Settings -> Environment Variables.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The Render backend URL (no trailing slash), e.g. https://problemforge-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public site URL, used for auth redirects, e.g. https://problemforge.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
