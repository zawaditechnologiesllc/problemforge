# ProblemForge backend — copy to .env for local development.
# On Render these are set as service environment variables (see render.yaml).

ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# Supabase (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
# Optional: legacy JWT secret (Project Settings -> API -> JWT). If unset,
# tokens are verified via the Supabase Auth API instead — both work.
SUPABASE_JWT_SECRET=

# Stripe (Dashboard -> Developers -> API keys / Webhooks / Products)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BUILDER=price_...      # $19/mo Builder plan
STRIPE_PRICE_PRO=price_...          # $49/mo Pro plan
STRIPE_PRICE_ENTERPRISE=price_...   # $150/mo Enterprise plan
STRIPE_PRICE_FTO=price_...          # $99 one-time Freedom-to-Operate report

# LLM aggregator (OpenAI-compatible: OpenRouter / DeepInfra / SiliconFlow)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
TRANSLATOR_MODEL=deepseek/deepseek-v4-flash
CODER_MODEL=qwen/qwen-3-coder

# Embeddings (needed for the vector Validator; falls back to text search if empty)
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Patent data sources — each activates automatically when its credentials
# are set; ingestion needs at least one.
# USPTO via PatentsView (primary; free key: patentsview.org/apis/keyrequest)
USPTO_API_KEY=
# Google Patents Public Data via BigQuery: paste the FULL service-account JSON
# on one line (GCP service account with the "BigQuery Job User" role)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Lens.org API token (lens.org -> subscriptions)
LENS_API_KEY=
# EPO Open Patent Services consumer key/secret (developers.epo.org)
EPO_OPS_KEY=
EPO_OPS_SECRET=

# Ingestion coverage: historical backfill floor for worker/backfill_history.
# Timeless by default — any public-domain patent qualifies regardless of age
# (a 1960s mechanism can still be the right solution today). Raise the floor
# if you want a narrower catalog.
INGEST_BACKFILL_START=1790-01-01

# Cache (cost saver): caches embeddings (7d), framework analyses (24h), and
# community demand signals (24h). Recommended: Upstash Redis (serverless,
# free tier) or Render Key Value — paste the rediss:// URL here. Leave empty
# for an in-process cache (fine for dev / single instance).
REDIS_URL=

# Community demand signals: real questions scraped politely (one cached
# request per source per query) from public old.reddit.com and Quora search
# pages — no API keys. Set false to disable scraping entirely.
DEMAND_SIGNALS_ENABLED=true

# Internal active-patent landscape corpus (Validator caution signal).
# The corpus is never exposed to users; set ACTIVE_SIGNAL_ENABLED=false to
# hide the aggregate caution note entirely.
ACTIVE_SIGNAL_ENABLED=true
ACTIVE_WINDOW_YEARS=5
